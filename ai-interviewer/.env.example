# ─────────────────────────────────────────────
# AI INTERVIEWER — Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to git
# ─────────────────────────────────────────────

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Recall.ai
RECALL_API_KEY=...
RECALL_WEBHOOK_SECRET=...

# Calendly
CALENDLY_WEBHOOK_SECRET=...

# Google Sheets
GOOGLE_SHEETS_ID=your-spreadsheet-id-here
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ElevenLabs (TTS)
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...

# App
PORT=3000
WEBHOOK_BASE_URL=https://yourapp.com
API_SECRET=your-internal-api-secret

# Notifications (optional)
NOTIFICATION_EMAIL=recruiter@yourcompany.com
GOOGLE_CHAT_WEBHOOK_URL=...
