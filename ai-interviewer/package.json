{
  "name": "ai-interviewer",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered interview system using Claude, Recall.ai, and Calendly",
  "workspaces": [
    "apps/api",
    "apps/dashboard"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:dashboard": "npm run dev --workspace=apps/dashboard",
    "build": "npm run build --workspaces",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "googleapis": "^140.0.0",
    "uuid": "^9.0.0",
    "express": "^4.18.0",
    "@types/express": "^4.17.0",
    "dotenv": "^16.4.0"
  }
}
